FROM python:3.11-slim
WORKDIR /app

RUN mkdir -p -v src

WORKDIR /app/src

COPY src/dashboard ./dashboard

WORKDIR /app

COPY src/dashboard/requirements.txt .
RUN pip install -r  requirements.txt --no-cache-dir
RUN pip freeze > requirements.txt

EXPOSE 8080

ENTRYPOINT ["streamlit", "run", "src/dashboard/streamlit_app.py", "--server.port=8080", "--server.address=0.0.0.0"]